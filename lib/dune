(library
 (name camlcoin)
 (public_name camlcoin)
 (libraries cstruct cstruct-unix lwt lwt.unix unix bigstring bigstringaf
            base64 cohttp-lwt-unix yojson digestif mirage-crypto
            mirage-crypto-rng mirage-crypto-rng.unix cmdliner
            logs logs.fmt fmt fmt.tty threads.posix zarith
            x509 domain-name)
 (foreign_stubs
  (language c)
  (names schnorr_stubs sha256_accel_stubs rocksdb_stubs zmq_stubs)
  ; rocksdb/c.h may live in a user-local prefix (e.g. ~/.local/include) that
  ; is not on the compiler's default include path.  A nonexistent -I dir is
  ; harmless, so this is a no-op on systems with rocksdb installed globally;
  ; CPATH remains an override for exotic layouts.
  (flags (:standard -I%{env:HOME=/usr/local}/.local/include))
  (include_dirs ../vendor/secp256k1/src ../vendor/secp256k1/include))
 (c_library_flags (-lcrypto -lrocksdb -l:libzmq.so.5 -lstdc++))
 (preprocess (pps lwt_ppx)))
